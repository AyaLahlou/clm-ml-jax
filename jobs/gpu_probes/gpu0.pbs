#!/bin/bash
#PBS -N clmml_gpu0
#PBS -A UCLB0069
#PBS -q develop
#PBS -l select=1:ncpus=16:ngpus=1:mem=200GB
#PBS -l walltime=01:30:00
#PBS -j oe
# GPU optimization probes (docs/design/gpu_progress.md, "Resume here"): timing, saved
# outputs, gradients and profiles of the compiled chunk on one A100. Time a fixed snapshot,
# not the working tree:  git worktree add --detach $SCRATCH/clm-ml-jax/trees/NAME COMMIT
#   qsub -v MODE=base,TAG=name,TREE=$SCRATCH/clm-ml-jax/trees/NAME jobs/gpu_probes/gpu0.pbs
# MODE: base (yardstick) | scale | save | grad | proto | prof.  Submit from a scratch
# directory: PBS writes its own .o file where qsub is run.
set -u
SCRATCH=${SCRATCH:-/glade/derecho/scratch/$USER}
REPO=${REPO:-/glade/work/$USER/clm-ml-jax}
HERE=$REPO/jobs/gpu_probes                 # the probe scripts
P=$SCRATCH/clm-ml-jax/probe_gpu0             # results, logs, saved outputs
T=${TREE:-$REPO}                             # the code to time: a git worktree (TREE) or the repo
mkdir -p $P
PROF=$SCRATCH/clm-ml-jax/prof0; mkdir -p $PROF
exec > >(tee -a $P/log_${TAG}.txt) 2>&1
module load cuda/12.9.0
export PATH=/glade/work/$USER/conda-envs/clm-ml-jax/bin:$PATH
export JAX_COMPILATION_CACHE_DIR=$SCRATCH/jax_compile_cache_gpu
export TMPDIR=$SCRATCH/tmp
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export JAX_PLATFORMS=cuda
cd $P
git -C $T log --oneline -1; hostname; date
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader; lscpu | grep "Model name"
G="configs/grid_1deg_2000"
filt() { grep -v "^W1\|^I1\|pjrt_executable"; }
run() { python -u $HERE/gpu0.py $T $G "$@" 2>&1 | filt | grep -E "^setup|^compile|^run |steady_ms|patch_steps|us_per|peak|Error|error|Traceback"; }

case ${XF:-} in   # XLA flag presets (plan step 1b)
nocb) XFLAGS="--xla_gpu_enable_command_buffer=" ;;
cbu)  XFLAGS="--xla_gpu_enable_command_buffer=FUSION,CUBLAS,CUBLASLT,CUSTOM_CALL,CUDNN,CONDITIONAL,WHILE --xla_gpu_graph_min_graph_size=1 --xla_gpu_command_buffer_unroll_loops=true" ;;
*)    XFLAGS="" ;;
esac
export XLA_FLAGS="$XFLAGS"
case $MODE in
base)   # 0a: the yardstick, global, one day; 0g: without checkpoints
  run domain.grid.region=global run.execution.devices=1 --steps 48 --repeat 3 --label "$TAG"
  if [ "${NOCKPT:-0}" = 1 ]; then
    CLM_ML_NO_CHECKPOINT=1 run domain.grid.region=global run.execution.devices=1 \
      model.numerics.checkpoint_steps=false --steps 48 --repeat 3 --label "$TAG no checkpoint"
  fi ;;
scale)  # 0b: step time against number of patches; 0f: C3 only against C3 + C4 (small boxes)
  for box in "{lat: [55, 57], lon: [-110, -105]}" "{lat: [35, 37], lon: [-100, -98]}" \
             "{lat: [35, 45], lon: [-105, -90]}" "{lat: [30, 50], lon: [-125, -70]}" \
             "{lat: [-35, 60], lon: [-20, 60]}"; do
    echo "== $box"
    run "domain.grid.region=$box" run.execution.devices=1 --steps 8 --repeat 4 --label "$TAG $box"
  done ;;
proto)  # prototype: another jnp.searchsorted method for the psihat table (global, one day)
  for m in $SS; do
    run domain.grid.region=global run.execution.devices=1 --steps 48 --repeat 3 \
      --searchsorted $m --label "$TAG searchsorted=$m"
    run "domain.grid.region={lat: [35, 37], lon: [-100, -98]}" run.execution.devices=1 \
      --steps 8 --repeat 4 --searchsorted $m --label "$TAG small searchsorted=$m"
    run "domain.grid.region={lat: [55, 57], lon: [-110, -105]}" run.execution.devices=1 \
      --steps 8 --repeat 4 --searchsorted $m --label "$TAG small C3 only searchsorted=$m"
  done ;;
save)   # one day of global output saved, from a fresh compile (GPU comparison runs, plan §5)
  export JAX_COMPILATION_CACHE_DIR=$PROF/cache_save_$TAG
  git -C $T log --oneline -1
  run domain.grid.region=global run.execution.devices=1 --steps ${STEPS:-48} --repeat ${REP:-2} \
    ${SS:+--searchsorted $SS} --label "$TAG" --save $P/save_$TAG.npz
  if [ -n "${REAL:-}" ]; then   # a padded chunk: REAL real steps of ${STEPS:-48}
    run domain.grid.region=global run.execution.devices=1 --steps ${STEPS:-48} --repeat 3 \
      --real $REAL --label "$TAG padded, $REAL real steps"
  fi
  if [ -n "${SMALL:-}" ]; then
    run "domain.grid.region={lat: [35, 37], lon: [-100, -98]}" run.execution.devices=1 \
      --steps 8 --repeat 4 --label "$TAG small"
  fi ;;
grad)   # gradient timing and memory (timing/time_vmap.py --grad; CHATS7 copies)
  cd $T && export PYTHONPATH=$T/src:$T
  git log --oneline -1
  for n in ${NS:-1 4096}; do
    python -u timing/time_vmap.py --patches $n --grad --label "$TAG" 2>&1 | filt \
      | grep -E "first_s|steady|per_step|patch_steps|max_rel|finite|peak|grad|Error|Traceback"
  done
  cp timing/results_vmap.jsonl $P/results_vmap_$TAG.jsonl ;;
prof)   # 0d: nsys profile of two steps (global and a small box), and the optimized HLO
  for name in global small; do
    [ $name = global ] && box=global || box="{lat: [35, 37], lon: [-100, -98]}"
    export JAX_COMPILATION_CACHE_DIR=$PROF/cache_${TAG}_$name   # empty: compile, so XLA dumps
    XLA_FLAGS="$XFLAGS --xla_dump_to=$PROF/hlo_${TAG}_$name --xla_dump_hlo_as_text" \
    nsys profile --capture-range=cudaProfilerApi --capture-range-end=stop -t cuda \
      --force-overwrite=true -o $PROF/${TAG}_$name \
      python -u $HERE/gpu0.py $T $G "domain.grid.region=$box" run.execution.devices=1 \
      --steps 2 --repeat 3 --profile ${SS:+--searchsorted $SS} --label "$TAG $name (nsys)" 2>&1 | filt \
      | grep -E "^setup|^compile|^run |steady_ms|Error|error|Traceback|Generat|nsys"
    nsys stats -r cuda_gpu_kern_sum,cuda_api_sum,cuda_gpu_mem_time_sum,cuda_gpu_mem_size_sum \
      -f csv --force-export=true -o $PROF/${TAG}_$name $PROF/${TAG}_$name.nsys-rep >/dev/null 2>&1
    ls -la $PROF | grep "${TAG}_$name" | head -20
  done ;;
esac
echo "ALL DONE $(date)"
